{
  "expo": {
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.anonymous.client",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SEND_SMS",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS"
      ]
    },
    "splash": {
      "image": "./src/components/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "name": "client",
    "slug": "client",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "Finia needs Contacts access to let you tag friends in transactions and send payment reminders."
        }
      ],
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cba8a595-343d-4a97-a75a-e36fe8132ea0"
      }
    },
    "owner": "daksh_mrigwani",
    "ios": {
      "bundleIdentifier": "com.anonymous.client",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Finia needs Contacts access to let you tag friends in transactions and send payment reminders.",
        "NSSMSUsageDescription": "Finia uses SMS to send payment reminders to your contacts."
      }
    }
  }
}
