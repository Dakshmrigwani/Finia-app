{
  "expo": {
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.anonymous.client"
    },
    "splash": {
      "image": "./src/components/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "name": "client",
    "slug": "client",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ]
  }
}
